{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "paths": {
      "~/*": ["./app/*"],
      "#imports": ["./.nuxt/imports.d.ts"]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.vue",
    "server/**/*.ts"
  ]
}
